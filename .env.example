# Copy to .env for local development. Real environment variables override these.

# PostgreSQL connection string (required)
DATABASE_URL=postgres://bookclub:CHANGE_ME@localhost:5432/bookclub?sslmode=disable

# Address to listen on. PORT is also honoured (for hosts like Fly.io / Railway).
ADDR=:8080

# Public URL of the app, used to build invite and reset links.
# If it starts with https://, cookies are marked Secure automatically.
BASE_URL=http://localhost:8080

# Time zone for meeting times and vote deadlines (IANA name). Defaults to the server's local zone.
# TIMEZONE=Europe/London

# Force Secure cookies on/off (default: on when BASE_URL is https).
# COOKIE_SECURE=true
