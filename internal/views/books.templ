package views

import "bookclub/internal/store"
import "bookclub/internal/openlibrary"
import "context"

type BooksData struct {
	Filter string
	Query  string
	Books  []*store.Book
}

templ BooksPage(d BooksData) {
	@Layout(t(ctx, "Books")) {
		<div class="page-head">
			<h1>{ t(ctx, "Books") }</h1>
			<div class="actions">
				<a class="btn btn-primary" href="/books/new">{ t(ctx, "Add a book") }</a>
			</div>
		</div>
		<div class="toolbar">
			<nav class="tabs" aria-label={ t(ctx, "Filter") }>
				<a href="/books?filter=wishlist" class={ templ.Classes(templ.KV("active", d.Filter == "wishlist")) }>{ t(ctx, "Want to read") }</a>
				<a href="/books?filter=read" class={ templ.Classes(templ.KV("active", d.Filter == "read")) }>{ t(ctx, "Club reads") }</a>
				<a href="/books?filter=all" class={ templ.Classes(templ.KV("active", d.Filter == "all")) }>{ t(ctx, "All") }</a>
			</nav>
			<form method="get" action="/books" class="search-form">
				<input type="hidden" name="filter" value={ d.Filter }/>
				<input type="search" name="q" value={ d.Query } placeholder={ t(ctx, "Search title or author") } aria-label={ t(ctx, "Search books") }/>
			</form>
		</div>
		if len(d.Books) == 0 {
			<div class="card empty">
				if d.Query != "" {
					<p>{ tf(ctx, "No books match %s.", q(ctx, d.Query)) }</p>
				} else if d.Filter == "wishlist" {
					<p>{ t(ctx, "The want-to-read list is empty.") } <a href="/books/new">{ t(ctx, "Add a book") }</a> { t(ctx, "you'd like the club to read.") }</p>
				} else if d.Filter == "read" {
					<p>{ t(ctx, "No books have been attached to a meeting yet.") }</p>
				} else {
					<p>{ t(ctx, "No books yet.") } <a href="/books/new">{ t(ctx, "Add the first one") }</a>.</p>
				}
			</div>
		} else {
			<ul class="book-grid">
				for _, b := range d.Books {
					<li>
						<a href={ url("/books/%d", b.ID) } class="book-tile">
							@cover(b, "m")
							<span class="book-tile-title">{ b.Title }</span>
							<span class="book-tile-author">{ b.Authors }</span>
							<span class="book-tile-tags">
								if b.OnWishlist {
									<span class="tag">{ t(ctx, "Want to read") }</span>
								}
								if b.MeetingCount > 0 {
									<span class="tag tag-read">{ t(ctx, "Club read") }</span>
								}
							</span>
						</a>
					</li>
				}
			</ul>
		}
	}
}

type BookData struct {
	Book        *store.Book
	Meetings    []*store.Meeting
	Nominations []store.BookNomination
	Comments    CommentsData
	History     []store.Activity
	CanDelete   bool
}

templ BookPage(d BookData) {
	@Layout(d.Book.Title) {
		<div class="book-detail">
			<div class="book-detail-cover">
				@cover(d.Book, "l")
			</div>
			<div class="book-detail-body">
				<p class="crumbs"><a href="/books">{ t(ctx, "Books") }</a></p>
				<h1>{ d.Book.Title }</h1>
				<p class="lead">{ bookByline(d.Book) }</p>
				<p class="booklink-row">
					@bookLinks(d.Book)
					if d.Book.OpenLibraryKey != "" {
						<a href={ templ.URL("https://openlibrary.org" + d.Book.OpenLibraryKey) } target="_blank" rel="noopener noreferrer" class="muted">Open Library ↗</a>
					}
				</p>
				@WishlistToggle(d.Book)
				@multiline(d.Book.Notes)
				<p class="muted small">
					if d.Book.AddedByName != "" {
						{ tf(ctx, "Added by %s · %s", d.Book.AddedByName, fmtDate(ctx, d.Book.CreatedAt)) }
					} else {
						{ tf(ctx, "Added %s", fmtDate(ctx, d.Book.CreatedAt)) }
					}
				</p>
				<div class="actions">
					<a class="btn btn-small" href={ url("/books/%d/edit", d.Book.ID) }>{ t(ctx, "Edit") }</a>
					if d.CanDelete {
						<form method="post" action={ url("/books/%d/delete", d.Book.ID) } class="inline" data-confirm={ t(ctx, "Delete this book from the library?") }>
							@csrfField()
							<button type="submit" class="btn btn-small btn-danger">{ t(ctx, "Delete") }</button>
						</form>
					}
				</div>
			</div>
		</div>
		<div class="grid-2">
			<section class="card">
				<h2>{ t(ctx, "Meetings") }</h2>
				if len(d.Meetings) == 0 {
					<p class="muted">{ t(ctx, "Not part of any meeting yet.") }</p>
				} else {
					<ul class="plain-list">
						for _, m := range d.Meetings {
							<li><a href={ url("/meetings/%d", m.ID) }>{ meetingName(ctx, m) }</a> <span class="muted small">{ fmtMeetingTime(ctx, m.StartsAt) }</span></li>
						}
					</ul>
				}
			</section>
			<section class="card">
				<h2>{ t(ctx, "Votes") }</h2>
				if len(d.Nominations) == 0 {
					<p class="muted">{ t(ctx, "Hasn't been suggested in a vote yet.") }</p>
				} else {
					<ul class="plain-list">
						for _, n := range d.Nominations {
							<li>
								<a href={ url("/polls/%d", n.PollID) }>{ n.PollTitle }</a>
								if n.Chosen {
									<span class="badge badge-ok">{ t(ctx, "Chosen") }</span>
								}
								<div class="muted small">
									if n.NominatedByName != "" {
										{ tf(ctx, "Suggested by %s", n.NominatedByName) }
									} else {
										{ t(ctx, "Suggested") }
									}
									if n.Pitch != "" {
										{ ": " + q(ctx, n.Pitch) }
									}
								</div>
							</li>
						}
					</ul>
				}
			</section>
		</div>
		@CommentsSection(d.Comments)
		@history(d.History)
	}
}

templ WishlistToggle(b *store.Book) {
	<form id="wishlist-toggle" method="post" action={ url("/books/%d/wishlist", b.ID) }
		hx-post={ path("/books/%d/wishlist", b.ID) } hx-target="this" hx-swap="outerHTML" class="wishlist-toggle">
		@csrfField()
		if b.OnWishlist {
			<input type="hidden" name="on" value="0"/>
			<span class="tag">{ t(ctx, "On the want-to-read list") }</span>
			<button type="submit" class="linkbtn small">{ t(ctx, "Remove from list") }</button>
		} else {
			<input type="hidden" name="on" value="1"/>
			<span class="muted small">{ t(ctx, "Not on the want-to-read list.") }</span>
			<button type="submit" class="linkbtn small">{ t(ctx, "Add to list") }</button>
		}
	</form>
}

type BookFormData struct {
	Book         *store.Book
	IsNew        bool
	Errors       map[string]string
	NominatePoll int64
	PollTitle    string
	Existing     *store.Book
}

templ BookFormPage(d BookFormData) {
	@Layout(bookFormTitle(ctx, d.IsNew)) {
		<div class="page-head">
			<h1>{ bookFormTitle(ctx, d.IsNew) }</h1>
		</div>
		if d.NominatePoll != 0 {
			<div class="flash flash-ok">{ tf(ctx, "After saving, the book will be suggested in %s.", q(ctx, d.PollTitle)) }</div>
		}
		if d.Existing != nil {
			<div class="flash flash-error">
				{ t(ctx, "This book is already in the library:") } <a href={ url("/books/%d", d.Existing.ID) }>{ d.Existing.Title }</a>.
			</div>
		}
		<div class={ templ.Classes("book-form-layout", templ.KV("with-search", d.IsNew)) }>
			if d.IsNew {
				<section class="card">
					<h2>{ t(ctx, "Search Open Library") }</h2>
					<p class="muted small">{ t(ctx, "Pick a result to fill in the details, then adjust anything you like.") }</p>
					<input type="search" name="q" placeholder={ t(ctx, "Title, author or ISBN") } aria-label={ t(ctx, "Search Open Library") }
						hx-get="/books/lookup" hx-trigger="input changed delay:450ms, search"
						hx-target="#lookup-results" hx-swap="innerHTML" hx-indicator="#lookup-spinner"/>
					<div id="lookup-spinner" class="htmx-indicator muted small">{ t(ctx, "Searching…") }</div>
					<div id="lookup-results" class="lookup-results"></div>
				</section>
			}
			<section class="card">
				if d.IsNew {
					<h2>{ t(ctx, "Details") }</h2>
				}
				@bookForm(d)
			</section>
		</div>
	}
}

func bookFormTitle(ctx context.Context, isNew bool) string {
	if isNew {
		return t(ctx, "Add a book")
	}
	return t(ctx, "Edit book")
}

templ bookForm(d BookFormData) {
	<form method="post" class="stack" id="book-form"
		if d.IsNew {
			action="/books"
		} else {
			action={ url("/books/%d", d.Book.ID) }
		}
	>
		@csrfField()
		if d.NominatePoll != 0 {
			<input type="hidden" name="nominate_poll" value={ itoa(d.NominatePoll) }/>
		}
		<input type="hidden" name="openlibrary_key" value={ d.Book.OpenLibraryKey }/>
		<div class="form-with-cover">
			<div class="cover-preview" id="cover-preview">
				@cover(d.Book, "m")
			</div>
			<div class="stack">
				<label>
					{ t(ctx, "Title") }
					<input type="text" name="title" value={ d.Book.Title } required maxlength="300"/>
					@fieldError(d.Errors, "title")
				</label>
				<label>
					{ t(ctx, "Author(s)") }
					<input type="text" name="authors" value={ d.Book.Authors } maxlength="300"/>
				</label>
				<label>
					{ t(ctx, "First published") }
					<input type="number" name="year" value={ yearStr(d.Book.Year) } min="-3000" max="3000" inputmode="numeric"/>
					@fieldError(d.Errors, "year")
				</label>
			</div>
		</div>
		<label>
			{ t(ctx, "Goodreads link") }
			<input type="url" name="goodreads_url" value={ d.Book.GoodreadsURL } placeholder="https://www.goodreads.com/book/show/…"/>
			<span class="hint">{ t(ctx, "Where everyone rates it. Filled in automatically when Open Library knows it.") }</span>
			@fieldError(d.Errors, "goodreads_url")
		</label>
		<label>
			{ t(ctx, "Cover image URL") }
			<input type="url" name="cover_url" value={ d.Book.CoverURL } data-cover-input/>
			@fieldError(d.Errors, "cover_url")
		</label>
		<label>
			{ t(ctx, "Notes") }
			<textarea name="notes" rows="4" maxlength="5000" placeholder={ t(ctx, "Why it's interesting, content notes, edition to get…") }>{ d.Book.Notes }</textarea>
		</label>
		<label class="check">
			<input type="checkbox" name="on_wishlist" value="1" checked?={ d.Book.OnWishlist }/>
			{ t(ctx, "On the club's want-to-read list") }
		</label>
		<div class="actions">
			<button type="submit" class="btn btn-primary">{ t(ctx, "Save book") }</button>
			if d.IsNew {
				<a href="/books" class="btn btn-ghost">{ t(ctx, "Cancel") }</a>
			} else {
				<a href={ url("/books/%d", d.Book.ID) } class="btn btn-ghost">{ t(ctx, "Cancel") }</a>
			}
		</div>
	</form>
}

templ LookupResults(results []openlibrary.Result, errMsg string, query string) {
	if errMsg != "" {
		<p class="field-error">{ errMsg }</p>
	} else if query != "" && len(results) == 0 {
		<p class="muted small">{ tf(ctx, "Nothing found for %s. You can fill in the details by hand.", q(ctx, query)) }</p>
	} else {
		<ul class="lookup-list">
			for _, r := range results {
				<li>
					<button type="button" class="lookup-item" data-fill-book={ bookJSON(r.Title, r.Authors, r.Year, r.CoverURL, r.GoodreadsURL, r.Key) }>
						if r.CoverURL != "" {
							<img src={ r.CoverURL } alt="" class="cover cover-s" loading="lazy" referrerpolicy="no-referrer"/>
						} else {
							<span class="cover cover-s cover-placeholder">{ initials(r.Title) }</span>
						}
						<span>
							<strong>{ r.Title }</strong>
							<span class="muted small">
								{ r.Authors }
								if r.Year > 0 {
									{ " · " + itoa(r.Year) }
								}
							</span>
							if r.GoodreadsURL != "" {
								<span class="small tag">{ t(ctx, "Goodreads link found") }</span>
							}
						</span>
					</button>
				</li>
			}
		</ul>
	}
}
