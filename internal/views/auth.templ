package views

import "bookclub/internal/store"

templ LoginPage(username, next, errMsg string) {
	@AuthLayout(t(ctx, "Log in")) {
		<h1>{ t(ctx, "Log in") }</h1>
		if errMsg != "" {
			<div class="flash flash-error">{ errMsg }</div>
		}
		<form method="post" action="/login" class="stack">
			<input type="hidden" name="next" value={ next }/>
			<label>
				{ t(ctx, "Username") }
				<input type="text" name="username" value={ username } autocomplete="username" autocapitalize="none" required autofocus/>
			</label>
			<label>
				{ t(ctx, "Password") }
				<input type="password" name="password" autocomplete="current-password" required/>
			</label>
			<button type="submit" class="btn btn-primary">{ t(ctx, "Log in") }</button>
		</form>
		<p class="muted small">{ t(ctx, "New here? You need an invite link from a member. Forgot your password? Ask any member to make you a reset link.") }</p>
	}
}

type AccountForm struct {
	DisplayName string
	Username    string
	Errors      map[string]string
}

templ accountFields(f AccountForm) {
	<label>
		{ t(ctx, "Your name") }
		<input type="text" name="display_name" value={ f.DisplayName } maxlength="60" required autocomplete="name"/>
		<span class="hint">{ t(ctx, "How you'll appear to the club.") }</span>
		@fieldError(f.Errors, "display_name")
	</label>
	<label>
		{ t(ctx, "Username") }
		<input type="text" name="username" value={ f.Username } maxlength="40" pattern="[A-Za-z0-9_.\-]+" required autocapitalize="none" autocomplete="username"/>
		<span class="hint">{ t(ctx, "For logging in. Letters, numbers, dots, dashes and underscores.") }</span>
		@fieldError(f.Errors, "username")
	</label>
	@passwordFields(f.Errors)
}

templ passwordFields(errs map[string]string) {
	<label>
		{ t(ctx, "Password") }
		<input type="password" name="password" minlength="8" required autocomplete="new-password"/>
		<span class="hint">{ t(ctx, "At least 8 characters.") }</span>
		@fieldError(errs, "password")
	</label>
	<label>
		{ t(ctx, "Repeat password") }
		<input type="password" name="password2" minlength="8" required autocomplete="new-password"/>
		@fieldError(errs, "password2")
	</label>
}

templ SetupPage(token string, valid bool, f AccountForm) {
	@AuthLayout(t(ctx, "Set up")) {
		<h1>{ t(ctx, "Welcome!") }</h1>
		if !valid {
			<p>{ t(ctx, "This app has no accounts yet. To create the first one, open the setup link printed in the server's log when it started.") }</p>
		} else {
			<p>{ t(ctx, "Create the first account. You'll be an admin and can then invite your friends.") }</p>
			<form method="post" action="/setup" class="stack">
				<input type="hidden" name="token" value={ token }/>
				<label>
					{ t(ctx, "Club name") }
					<input type="text" name="club_name" value={ clubName(ctx) } maxlength="80" required/>
				</label>
				@accountFields(f)
				<button type="submit" class="btn btn-primary">{ t(ctx, "Create account") }</button>
			</form>
		}
	}
}

templ JoinPage(token string, inv *store.Invite, f AccountForm) {
	@AuthLayout(t(ctx, "Join")) {
		if inv == nil || !inv.Usable() {
			<h1>{ t(ctx, "Invite not valid") }</h1>
			<p>{ t(ctx, "This invite link has expired, was already used, or was revoked. Ask a member for a new one.") }</p>
			<p><a href="/login">{ t(ctx, "Log in instead") }</a></p>
		} else {
			<h1>{ tf(ctx, "Join %s", clubName(ctx)) }</h1>
			if inv.CreatedByName != "" {
				<p class="muted">{ tf(ctx, "%s invited you.", inv.CreatedByName) }</p>
			}
			<form method="post" action={ url("/join/%s", token) } class="stack">
				@accountFields(f)
				<button type="submit" class="btn btn-primary">{ t(ctx, "Create my account") }</button>
			</form>
		}
	}
}

templ ResetPage(token string, user *store.User, valid bool, errs map[string]string) {
	@AuthLayout(t(ctx, "Reset password")) {
		if !valid {
			<h1>{ t(ctx, "Link not valid") }</h1>
			<p>{ t(ctx, "This reset link has expired or was already used. Ask a member for a new one.") }</p>
		} else {
			<h1>{ t(ctx, "Choose a new password") }</h1>
			<p class="muted">{ tf(ctx, "For %s (%s).", user.DisplayName, user.Username) }</p>
			<form method="post" action={ url("/reset/%s", token) } class="stack">
				@passwordFields(errs)
				<button type="submit" class="btn btn-primary">{ t(ctx, "Set password and log in") }</button>
			</form>
		}
	}
}

templ MePage(u *store.User, nameErr string, pwErrs map[string]string) {
	@Layout(t(ctx, "Your account")) {
		<div class="page-head">
			<h1>{ t(ctx, "Your account") }</h1>
		</div>
		<div class="grid-2">
			<section class="card">
				<h2>{ t(ctx, "Profile") }</h2>
				<form method="post" action="/me" class="stack">
					@csrfField()
					<label>
						{ t(ctx, "Your name") }
						<input type="text" name="display_name" value={ u.DisplayName } maxlength="60" required/>
						if nameErr != "" {
							<p class="field-error">{ nameErr }</p>
						}
					</label>
					<p class="muted small">{ tf(ctx, "Username: %s · member since %s", u.Username, fmtDate(ctx, u.CreatedAt)) }</p>
					<button type="submit" class="btn">{ t(ctx, "Save") }</button>
				</form>
			</section>
			<section class="card">
				<h2>{ t(ctx, "Change password") }</h2>
				<form method="post" action="/me/password" class="stack">
					@csrfField()
					<label>
						{ t(ctx, "Current password") }
						<input type="password" name="current" required autocomplete="current-password"/>
						@fieldError(pwErrs, "current")
					</label>
					@passwordFields(pwErrs)
					<button type="submit" class="btn">{ t(ctx, "Change password") }</button>
				</form>
			</section>
			<section class="card">
				<h2>{ t(ctx, "Language") }</h2>
				<p class="muted small">{ t(ctx, "The app is available in English and Icelandic. Your choice is remembered on this device.") }</p>
				<div class="actions">
					<a class={ templ.Classes("btn", "btn-small", templ.KV("btn-primary", lang(ctx) == "en")) } href={ langURL(ctx, "en") } lang="en">English</a>
					<a class={ templ.Classes("btn", "btn-small", templ.KV("btn-primary", lang(ctx) == "is")) } href={ langURL(ctx, "is") } lang="is">Íslenska</a>
				</div>
			</section>
			<section class="card">
				<h2>{ t(ctx, "Theme") }</h2>
				<p class="muted small">{ t(ctx, "Choose how the app looks. Your choice is remembered on this device.") }</p>
				<div class="actions theme-buttons">
					for _, o := range themeOptions(ctx) {
						<a class="btn btn-small" href={ themeURL(ctx, o.Name) } data-theme-choice={ o.Name } aria-current={ ariaCurrent(currentTheme(ctx) == o.Name) }>
							<span class={ "swatch", "swatch-" + o.Name } aria-hidden="true"></span>
							{ o.Label }
						</a>
					}
				</div>
			</section>
		</div>
	}
}
