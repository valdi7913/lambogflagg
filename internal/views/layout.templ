package views

import "bookclub/internal/store"
import "bookclub/internal/i18n"
import "strings"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang={ string(lang(ctx)) }
		if th := req(ctx).Theme; th != "" {
			data-theme={ th }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="htmx-config" content={ htmxConfig }/>
			<title>{ title } · { clubName(ctx) }</title>
			<link rel="icon" href={ asset("/static/favicon.png") } type="image/png"/>
			<link rel="apple-touch-icon" href={ asset("/static/apple-touch-icon.png") }/>
			<link rel="stylesheet" href={ asset("/static/css/app.css") }/>
			<script src={ asset("/static/js/htmx.min.js") } defer></script>
			<script src={ asset("/static/js/app.js") } defer></script>
		</head>
		<body hx-headers={ csrfHeaders(ctx) } data-copied={ t(ctx, "Link copied") }
			data-error-generic={ t(ctx, "Something went wrong. Reload and try again.") }
			data-error-offline={ t(ctx, "Couldn't reach the server. Check your connection.") }
			data-points-left={ t(ctx, "%d left.") } data-points-over={ t(ctx, "%d too many!") }>
			if u := currentUser(ctx); u != nil {
				@topbar(u)
			}
			<main class="container" id="main">
				@flash()
				{ children... }
			</main>
			<div id="toast" class="toast" role="status" aria-live="polite" hidden></div>
		</body>
	</html>
}

templ topbar(u *store.User) {
	<header class="topbar">
		<div class="container topbar-inner">
			<a class="brand" href="/">
				<img class="brand-mark" src={ asset("/static/favicon.png") } width="30" height="30" alt=""/>
				<span>{ clubName(ctx) }</span>
			</a>
			<nav class="mainnav" aria-label={ t(ctx, "Main") }>
				@navLink("/", t(ctx, "Home"))
				@navLink("/meetings", t(ctx, "Meetings"))
				@navLink("/books", t(ctx, "Books"))
				@navLink("/polls", t(ctx, "Votes"))
				@navLink("/members", t(ctx, "Members"))
				@navLink("/activity", t(ctx, "History"))
			</nav>
			<div class="usermenu">
				@themeMenu()
				@langSwitch()
				<a href="/me" class={ templ.Classes(templ.KV("active", req(ctx).Path == "/me")) }>{ u.DisplayName }</a>
				<form method="post" action="/logout" class="inline">
					@csrfField()
					<button type="submit" class="linkbtn">{ t(ctx, "Log out") }</button>
				</form>
			</div>
		</div>
	</header>
}

// themeMenu is a small dropdown for choosing the colour theme. It works as
// plain links without JavaScript.
templ themeMenu() {
	<details class="theme-menu">
		<summary title={ t(ctx, "Theme") }>
			<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 2v16a8 8 0 0 1 0-16Z"></path></svg>
			<span class="sr-only">{ t(ctx, "Theme") }</span>
		</summary>
		<ul class="theme-list">
			for _, o := range themeOptions(ctx) {
				<li>
					<a href={ themeURL(ctx, o.Name) } data-theme-choice={ o.Name } aria-current={ ariaCurrent(currentTheme(ctx) == o.Name) }>
						<span class={ "swatch", "swatch-" + o.Name } aria-hidden="true"></span>
						{ o.Label }
					</a>
				</li>
			}
		</ul>
	</details>
}

// langSwitch offers the other language, written in that language.
templ langSwitch() {
	if lang(ctx) == i18n.IS {
		<a href={ langURL(ctx, i18n.EN) } hreflang="en" lang="en" class="langswitch" title="Switch to English">English</a>
	} else {
		<a href={ langURL(ctx, i18n.IS) } hreflang="is" lang="is" class="langswitch" title="Skipta yfir á íslensku">Íslenska</a>
	}
}

templ navLink(href, label string) {
	if href == "/" {
		<a href={ templ.SafeURL(href) } class={ templ.Classes(templ.KV("active", req(ctx).Path == "/")) }>{ label }</a>
	} else {
		<a href={ templ.SafeURL(href) } class={ templ.Classes(templ.KV("active", strings.HasPrefix(req(ctx).Path, href))) }>{ label }</a>
	}
}

templ flash() {
	if f := req(ctx).Flash; f != nil {
		<div class={ "flash", "flash-" + f.Kind } role="status">{ f.Message }</div>
	}
}

templ csrfField() {
	<input type="hidden" name="csrf" value={ req(ctx).CSRF }/>
}

// AuthLayout is a centred card for login and sign-up pages.
templ AuthLayout(title string) {
	@Layout(title) {
		<div class="auth-wrap">
			<div class="card auth-card">
				<div class="auth-art" aria-hidden="true"></div>
				<div class="auth-head">
					<div class="auth-brand">{ clubName(ctx) }</div>
					<div class="auth-switches">
						@themeMenu()
						@langSwitch()
					</div>
				</div>
				{ children... }
			</div>
		</div>
	}
}

templ ErrorPage(status int, message string) {
	@Layout(t(ctx, "Error")) {
		<div class="empty-state">
			<h1>{ itoa(status) }</h1>
			<p>{ message }</p>
			<p><a href="/" class="btn">{ t(ctx, "Go home") }</a></p>
		</div>
	}
}

templ fieldError(errs map[string]string, field string) {
	if msg, ok := errs[field]; ok {
		<p class="field-error">{ msg }</p>
	}
}

templ multiline(text string) {
	if text != "" {
		<div class="prose">{ text }</div>
	}
}

templ cover(b *store.Book, size string) {
	if b.CoverURL != "" {
		<img class={ "cover", "cover-" + size } src={ b.CoverURL } alt="" loading="lazy" referrerpolicy="no-referrer"/>
	} else {
		<div class={ "cover", "cover-" + size, "cover-placeholder" } aria-hidden="true">{ initials(b.Title) }</div>
	}
}

templ bookLinks(b *store.Book) {
	<span class="booklinks">
		if b.GoodreadsURL != "" {
			<a href={ templ.URL(b.GoodreadsURL) } target="_blank" rel="noopener noreferrer">Goodreads ↗</a>
		} else {
			<a href={ templ.URL(goodreadsSearch(b)) } target="_blank" rel="noopener noreferrer" class="muted">{ t(ctx, "Find on Goodreads ↗") }</a>
		}
	</span>
}

templ history(items []store.Activity) {
	<details class="history">
		<summary>{ tf(ctx, "History (%d)", len(items)) }</summary>
		@activityList(items, false)
	</details>
}

templ activityList(items []store.Activity, withLinks bool) {
	if len(items) == 0 {
		<p class="muted">{ t(ctx, "Nothing yet.") }</p>
	} else {
		<ul class="activity">
			for _, a := range items {
				<li>
					<div>
						<strong>{ activityUser(ctx, a) }</strong>
						{ " " + activitySummary(ctx, a) }
						if withLinks && a.Action != "delete" {
							if u := subjectURL(a.SubjectType, a.SubjectID); u != "" {
								{ " " }
								<a href={ templ.URL(u) } class="muted">{ t(ctx, "view") }</a>
							}
						}
					</div>
					if len(a.Changes) > 0 {
						<ul class="changes">
							for _, c := range a.Changes {
								<li><span class="field">{ fieldLabel(ctx, c.Field) }</span>: <del>{ fieldValue(ctx, c.Field, c.From) }</del> → <ins>{ fieldValue(ctx, c.Field, c.To) }</ins></li>
							}
						</ul>
					}
					<time datetime={ isoTime(a.CreatedAt) } title={ fmtDateTime(ctx, a.CreatedAt) }>{ ago(ctx, a.CreatedAt) }</time>
				</li>
			}
		</ul>
	}
}
